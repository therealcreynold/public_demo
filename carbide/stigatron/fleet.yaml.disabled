defaultNamespace: carbide-stigatron-system
labels:
  carbide-stage: stigatron
helm:
  repo: https://rancherfederal.github.io/carbide-charts
  chart: stigatron
  version: 0.4.1
  # values:
  #   heimdall2.heimdall.rcidf.tag:  "0.1.2-RC2"
  # releaseName: carbide-charts/stigatron
  valuesFiles:
    - values.yaml

# Label selectors, for the reason given in cis-benchmark/operator/fleet.yaml.
dependsOn:
- selector:
    matchLabels:
      carbide-stage: cis-operator
- selector:
    matchLabels:
      carbide-stage: license
